# Copie para .env.local no desenvolvimento.
# Na Vercel: Settings → Environment Variables (mesmos nomes).

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# URL pública (produção). Usada por scripts/psicodesk e npm run site:url
# NEXT_PUBLIC_SITE_URL=https://clinica-online-ten.vercel.app

# Opcional: push local para GitHub (nunca commite o valor real)
# GITHUB_TOKEN=ghp_...

# Opcional: deploy completo pela CLI (npm run vercel:bootstrap) — crie em https://vercel.com/account/tokens
# VERCEL_TOKEN=
# VERCEL_TEAM=              # slug da equipa Vercel, só se não for a conta pessoal
# VERCEL_PROJECT_NAME=      # nome exato do projeto no dashboard (ex.: project-k9jnt); se vazio, usa "clinica-online"

# Opcional: scripts locais de RLS/backfill e “production:sync-supabase-auth” (não exponha na Vercel)
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_SERVICE_ROLE_KEY=   # só local: backfill / admin; nunca na Vercel
# Depois: npm run db:fix-evolucoes-supabase  (RLS + backfill evoluções, um comando)
# TEST_EMAIL=
# TEST_PASSWORD=

